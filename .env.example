# Supabase project credentials (Settings → API in your Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is server-only — never exposed to the browser.
# Used for: contact-form inserts, and all admin dashboard reads/writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public anon credentials — required for the public /directory pages and for
# admin login (Supabase Auth session). Safe to expose to the browser; the
# anon key only grants what the RLS policies in supabase/phase2-directory-schema.sql
# allow (public read of verified agencies, nothing else).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics — leave empty until real IDs exist. No tracking is initialized without these.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
